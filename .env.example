# --- LangSmith (prompt hub) ---
LANGSMITH_API_KEY=
# Optional: only if your account is not on the US cloud / has several workspaces
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# Prompt push/pull do not need tracing; keep it off to save the monthly trace quota.
LANGSMITH_TRACING=false

# --- AWS (credentials live in a named profile, never in this file) ---
# aws configure --profile sandbox
AWS_PROFILE=sandbox
AWS_REGION=us-east-1

# --- App ---
PROMPTOPS_PROMPT_NAME=document-intake-triage
PROMPTOPS_DEFAULT_REF=prod
PROMPTOPS_DEFAULT_MODEL=nova-lite
# Created by `promptops bootstrap`; used for prompt cache + audit records
PROMPTOPS_S3_BUCKET=
